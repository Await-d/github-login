# GitHub账号管理系统 - 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ===========================================
# JWT配置 (必须修改!)
# ===========================================
# JWT密钥 - 生产环境必须使用强随机密钥!
# 可以使用以下命令生成: openssl rand -hex 32
JWT_SECRET_KEY=your_secret_key_here_change_this_in_production

# JWT算法
JWT_ALGORITHM=HS256

# JWT令牌过期时间(分钟) 默认43200=30天
JWT_EXPIRE_MINUTES=43200

# ===========================================
# 数据库加密配置 (可选)
# ===========================================
# 数据库字段加密密钥
# ENCRYPTION_KEY=your_encryption_key_here

# ===========================================
# 速率限制配置
# ===========================================
# 是否启用速率限制 (true/false)
RATE_LIMIT_ENABLED=true

# ===========================================
# 批量操作限制
# ===========================================
# 批量导入最大仓库数量
MAX_BATCH_IMPORT_SIZE=100

# ===========================================
# 任务队列配置
# ===========================================
# 账号间最小延迟(秒)
ACCOUNT_DELAY_MIN=3

# 账号间最大延迟(秒)
ACCOUNT_DELAY_MAX=8

# 失败重试次数
MAX_RETRY=2

# 重试延迟(秒)
RETRY_DELAY=10

# ===========================================
# 应用配置
# ===========================================
# 服务端口
PORT=3000

# ===========================================
# 安全建议
# ===========================================
# 1. JWT_SECRET_KEY 必须修改为强随机字符串
# 2. 生产环境不要使用默认值
# 3. 定期更换密钥并重新登录所有用户
# 4. 保持此文件权限为 600 (仅所有者可读写)
# 5. 不要将此文件提交到版本控制系统
